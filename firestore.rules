rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Vérifie si l'utilisateur connecté est un administrateur (basé sur son email)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "ton.courriel@ens.etsmtl.ca"
        // Ajoute d'autres emails d'admins ici si besoin :
        // || request.auth.token.email == "autre.admin@ens.etsmtl.ca"
      );
    }

    // Inscriptions au tournoi
    match /inscriptions/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /contacts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /rapports/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /arbitres/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Gestion des matchs : Sécurisé !
    match /matchs/{matchId} {
      allow read: if true;
      // Un match peut être modifié uniquement si :
      // 1. C'est un administrateur
      // 2. OU l'utilisateur connecté fait partie des joueurs du match (resource.data.player1 ou player2)
      // 3. OU il s'inscrit en tant que l'un des joueurs lors de la création
      allow write: if request.auth != null && (
        isAdmin() || 
        request.auth.uid == request.resource.data.player1Id || 
        request.auth.uid == request.resource.data.player2Id ||
        request.auth.uid == resource.data.player1Id || 
        request.auth.uid == resource.data.player2Id
      );
    }
    
    // Paramètres globaux du tournoi : Réservé aux admins uniquement
    match /tournoi/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
